# Python (кэш и временные файлы)
**/__pycache__/

# Виртуальное окружение (обязательно игнорируем)
venv/
.venv/
env/

# Настройки VS Code
.vscode/

# Per-machine graphics preset (auto-detected on first run; must NOT be
# shared between machines or the Intel auto-fallback won't trigger)
config/graphics.json

# Настройки съёмки датасета (правятся в диалоге, у каждого свои;
# умолчания лежат в src/ui/dataset_config.py)
config/dataset.json

# Логи и отчеты об ошибках
*.log

# Переменные окружения (секреты, ключи API)
.env

# Ключ Google Gemini (постобработка датасета). Пример — config/gemini.example.json
config/gemini.json

# Кэш сгенерированных Gemini фонов
assets/backgrounds/_gemini_cache/

/renders
config/tls_config.yaml
config/higgsfield.json
